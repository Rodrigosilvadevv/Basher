# Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Servidor no Render (pagamentos Apple e exclusão de conta)
VITE_API_URL=https://api.basher.com.br

# Endereço público do app (usado no login web e links)
VITE_APP_URL=https://basher.com.br

# Mapa (opcional). Para uso comercial use um provedor pago (MapTiler, Stadia, Mapbox).
# VITE_MAP_TILES=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap &copy; CARTO

# Deixe "true" para rodar com dados simulados, sem Supabase.
VITE_DEMO=false

# Supabase (Project Settings > API) — a service_role fica SÓ aqui no servidor
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# App Store
APPLE_BUNDLE_ID=br.com.basher.app
# Apple ID numérico do app (App Store Connect > App Information). Necessário em produção.
APPLE_APP_ID=

# Origens permitidas (app iOS, site e dev)
CORS_ORIGINS=capacitor://localhost,https://basher.com.br,https://www.basher.com.br,http://localhost:5173

# Opcional: segredo do webhook do provedor de verificação de idade
AGE_WEBHOOK_SECRET=
